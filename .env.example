# ---------------------------------------------------------------------------
# Environment variables for the Smadar lactation consulting website.
# Copy this file to `.env.local` and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Contact form email delivery ------------------------------------------
# The contact form API route (/api/contact) sends an email notification to
# Smadar on each submission. It uses Resend (https://resend.com) if configured.
# If RESEND_API_KEY is empty, submissions are validated and logged to the
# server console instead of emailed (safe for local development).

RESEND_API_KEY=
# Verified sender address for Resend (e.g. "Smadar Website <noreply@yourdomain.co.il>")
CONTACT_FROM_EMAIL=
# Where inquiry notifications are delivered (Smadar's inbox)
CONTACT_TO_EMAIL=

# --- Anti-spam -------------------------------------------------------------
# Optional shared secret; leave blank to rely on the built-in honeypot +
# timing checks only.
CONTACT_FORM_SECRET=
